import Ethereum.BLAKE2
import Ethereum.Wheels

/-!
Test vectors for the BLAKE2 F precompile's function, `Ethereum.BLAKE2.compressInput`, and
its input validation. The checks run when this module is built
(`lake build Ethereum.BLAKE2Tests`); the library does not import it.
-/

namespace Ethereum.BLAKE2Tests

open BLAKE2

private def bytes (s : String) : ByteArray :=
  match ByteArray.ofBlob s with
  | .ok b => b
  | .error _ => .empty

private def hex (b : ByteArray) : String :=
  let d := "0123456789abcdef".toList.toArray
  String.ofList <| b.data.toList.flatMap fun x => [d[x.toNat / 16]!, d[x.toNat % 16]!]

/-- `precompile` as the logic defines it (`precompile_eq`), without the C function. -/
private def run (s : String) : Option String :=
  let d := bytes s
  if d.size = 213 ∧ d[212]! ≤ 1 then some (hex (compressInput d)) else none

