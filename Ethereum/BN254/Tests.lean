-- Invalid points fail: a coordinate equal to `p`, and `(1, 3)`, which is not on the curve.
#guard ecadd (w p ++ w 2 ++ w 1 ++ w 2) == none
#guard ecadd (w 1 ++ w 2 ++ w 1 ++ w 3) == none
#guard ecmul (w 1 ++ w 3 ++ w 2) == none
-- `(0, 0)` is the point at infinity, and `(0, y)` for `y ≠ 0` is not on the curve.
#guard ecadd (w 0 ++ w 0 ++ w 1 ++ w 2) == some (w 1 ++ w 2)
#guard ecadd (w 0 ++ w 1 ++ w 1 ++ w 2) == none
-- `G + (-G) = 0`, and the order `r` of `G` multiplies it to `0`.
#guard ecadd (w 1 ++ w 2 ++ w 1 ++ w (p - 2)) == some (w 0 ++ w 0)
#guard ecmul (w 1 ++ w 2 ++
  w 21888242871839275222246405745257275088548364400416034343698204186575808495617) ==
  some (w 0 ++ w 0)
-- Gas below the cost fails.
#guard (Ξ_BN_ADD σ₀ ⟨149⟩ default (env (bytes (w 1 ++ w 2)))).1 == ∅

-- The kernel evaluates ECADD on `G + G`.
example : add 1 2 1 2 = some (Weierstrass.toBytes32
    0x030644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd3 ++
    Weierstrass.toBytes32 0x15ed738c0e0a7c92e7845f96b2ae9c0a68a6a449e3538fc7ff3ebf7a5a18a2c4) := by
  decide +kernel

