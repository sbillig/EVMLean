import Ethereum.Theory.BN254

/-!
Test vectors for the ECADD and ECMUL precompiles, run through `Ξ_BN_ADD` and
`Ξ_BN_MUL`. The checks run when this module is built
(`lake build Ethereum.BN254.Tests`); the library does not import it.
-/

namespace Ethereum.BN254Tests

open BN254

private def bytes (s : String) : ByteArray :=
  match ByteArray.ofBlob s with
  | .ok b => b
  | .error _ => .empty

/-- A nonempty account map, so that failure (an empty map) can be told apart. -/
private def σ₀ : AccountMap := (∅ : AccountMap).insert 0 default

private def env (d : ByteArray) : ExecutionEnv := { (default : ExecutionEnv) with calldata := d }

/-- The output of ECADD on the call data `s` (hex), or `none` if the call fails. -/
private def ecadd (s : String) : Option String :=
  let (σ, _, _, o) := Ξ_BN_ADD σ₀ ⟨100000⟩ default (env (bytes s))
  if σ == ∅ then none else some (toHex o)

/-- The output of ECMUL on the call data `s` (hex), or `none` if the call fails. -/
private def ecmul (s : String) : Option String :=
  let (σ, _, _, o) := Ξ_BN_MUL σ₀ ⟨100000⟩ default (env (bytes s))
  if σ == ∅ then none else some (toHex o)

private def w (n : ℕ) : String := toHex (Weierstrass.toBytes32 n)

