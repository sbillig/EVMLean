import Ethereum.PrecompiledContracts
import Ethereum.Modexp.Spec

/-!
Test vectors for the MODEXP precompile `Ξ_EXPMOD`: go-ethereum's
`core/vm/testdata/precompiles/modexp_eip2565.json`, each with its EIP-2565 gas and its output.
The checks run when this module is built (`lake build Ethereum.ModexpTests`); the library does
not import it. `Ethereum/ModexpDiff.py` compares the precompile with Python's `pow` on generated
inputs.
-/

namespace Ethereum.ModexpTests

private def bytes (s : String) : ByteArray :=
  match ByteArray.ofBlob s with
  | .ok b => b
  | .error _ => .empty

private def hex (b : ByteArray) : String :=
  let d := "0123456789abcdef".toList.toArray
  String.ofList <| b.data.toList.flatMap fun x => [d[x.toNat / 16]!, d[x.toNat % 16]!]

/-- The precompile's gas, from the specification, and its output, with all the gas it needs. -/
private def run (s : String) : ℕ × String :=
  let I : ExecutionEnv := { (default : ExecutionEnv) with calldata := bytes s }
  (Modexp.gas I.calldata, hex (Ξ_EXPMOD ∅ (UInt256.ofNat (2 ^ 255)) default I).2.2.2)

