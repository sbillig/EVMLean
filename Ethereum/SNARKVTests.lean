import Ethereum.Theory.SNARKV

/-!
Test vectors for the ECPAIRING precompile (`0x08`), run through `Ξ_SNARKV`.
The checks run when this module is built (`lake build Ethereum.SNARKVTests`); the library does not
import it.
-/

namespace Ethereum.SNARKVTests

private def bytes (s : String) : ByteArray :=
  match ByteArray.ofBlob s with
  | .ok b => b
  | .error _ => .empty

/-- A nonempty account map, so that failure (an empty map) can be told apart. -/
private def σ₀ : AccountMap := (∅ : AccountMap).insert 0 default

private def env (d : ByteArray) : ExecutionEnv := { (default : ExecutionEnv) with calldata := d }

/-- The gas used and the output of ECPAIRING on the call data `s` (hex), with 10,000,000 gas, or
`none` if the call fails. -/
private def run (s : String) : Option (ℕ × String) :=
  let (σ, g, _, o) := Ξ_SNARKV σ₀ ⟨10000000⟩ default (env (bytes s))
  if σ == ∅ then none else some (10000000 - g.toNat, toHex o)

